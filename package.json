{
  "name": "maya-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages --ext .ts,.tsx",
    "verify:panes": "node tools/verify/panes.mjs",
    "verify:live": "node tools/verify/live-run.mjs",
    "verify:conflict": "node tools/verify/conflict.mjs",
    "verify:width": "node tools/verify/column-width.mjs",
    "verify:mcp": "node tools/verify/mcp.mjs",
    "verify:planning": "node tools/verify/planning.mjs",
    "verify:agents": "node tools/verify/agents.mjs",
    "package": "node tools/package.mjs",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.25.12",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
